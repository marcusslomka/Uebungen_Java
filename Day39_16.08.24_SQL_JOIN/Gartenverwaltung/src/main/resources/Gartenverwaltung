1.
SELECT GartenID, SUM (Anzahl)
FROM GARTENPFLANZEN
GROUP BY GARTENID;

2.
SELECT p.NAME as Pflanzenname, gf.Anzahl, gf.GARTENID
FROM  GARTENPFLANZEN as gf
   INNER JOIN
      PFLANZE as p
      ON p.PFLANZENID = gf.PFLANZENID
   INNER JOIN
      GARTEN as g
      ON g.GARTENID = gf.GARTENID
   WHERE g.NAME = 'Blumenparadies'
;

3.
SELECT g.GARTENID, Sum(Anzahl), g.NAME,
FROM  GARTENPFLANZEN gf
   INNER JOIN GARTEN g
   ON g.GARTENID = gf.GARTENID
GROUP BY g.GARTENID
HAVING Sum(Anzahl) < 200;

4.
SELECT p.NAme, WASSERBEDARFPROPFLANZE
FROM  GARTENPFLANZEN gf
   INNER JOIN GARTEN g
   ON g.GARTENID = gf.GARTENID
   INNER JOIN PFLANZE p
   ON p.PFLANZENID = gf.PFLANZENID
WHERE g.NAME = 'Kräutergarten' AND ESSBAR = TRUE
;

5.
SELECT avg(Anzahl), GARTENID
FROM  GARTENPFLANZEN gf
GROUP BY GARTENID
;

6.
SELECT p.NAME
FROM  GARTENPFLANZEN gf
   LEFT JOIN GARTEN g
   ON g.GARTENID = gf.GARTENID
   LEFT JOIN PFLANZE p
   ON p.PFLANZENID = gf.PFLANZENID
WHERE ESSBAR = TRUE AND g.NAME = 'Kräutergarten'
;
----------2 Joins nötig---------
1.
SELECT g.NAME
FROM  GARTENPFLANZEN gf
   LEFT JOIN GARTEN g
   ON g.GARTENID = gf.GARTENID
   LEFT JOIN PFLANZE p
   ON p.PFLANZENID = gf.PFLANZENID
WHERE p.ESSBAR = TRUE
GROUP BY g.NAME
;

2.
SELECT g.NAME
FROM  GARTENPFLANZEN gf
   LEFT JOIN GARTEN g
   ON g.GARTENID = gf.GARTENID
   LEFT JOIN PFLANZE p
   ON p.PFLANZENID = gf.PFLANZENID
WHERE WASSERBEDARFPROPFLANZE >= 10
GROUP BY g.NAME
;

3.
SELECT g.NAME as Garten, SUM(WASSERBEDARFPROPFLANZE * ANZahl ) as WasserverbauchProGarten
FROM  GARTENPFLANZEN gf
   LEFT JOIN GARTEN g
   ON g.GARTENID = gf.GARTENID
   LEFT JOIN PFLANZE p
   ON p.PFLANZENID = gf.PFLANZENID
GROUP BY g.NAME
;

4.
SELECT g.NAME as Garten, SUM(WASSERBEDARFPROPFLANZE * ANZahl ) as WasserverbauchProGarten
FROM  GARTENPFLANZEN gf
   LEFT JOIN GARTEN g
   ON g.GARTENID = gf.GARTENID
   LEFT JOIN PFLANZE p
   ON p.PFLANZENID = gf.PFLANZENID
GROUP BY g.NAME
ORDER BY `WasserverbauchProGarten` DESC LIMIT 1
;

