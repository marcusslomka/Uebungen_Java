2.1
SELECT SITZPLAETZE, STEHPLAETZE
FROM ZUG
WHERE ZUG_ID in (
    SELECT ZUG_ID
    FROM ZUGVERBINDUNG
    WHERE ANKUNFTSORT  = 'Frankfurt'
);

2.2
SELECT *
FROM ZUGVERBINDUNG
WHERE ZUG_ID IN (
   SELECT ZUG_ID
   FROM ZUG
   WHERE KATEGORIE_ID = (
       SELECT KATEGORIE_ID
       FROM KATEGORIE
       WHERE NAME = 'ICE'
));

2.3
SELECT SUM(SITZPLAETZE )
FROM ZUG
WHERE ZUG_ID in (
   SELECT ZUG_ID
   FROM ZUGVERBINDUNG
   WHERE DATUM = '2024-08-16');

