----erstellen der Tables------

CREATE TABLE KATEGORIE (
KATEGORIE_ID INT PRIMARY KEY,
NAME VARCHAR(50))

CREATE TABLE ZUGVERBINDUNG (
ZUG_ID INT PRIMARY KEY,
KATEGORIE_ID INT,
FOREIGN KEY (KATEGORIE_ID) REFERENCES KATEGORIE (KATEGORIE_ID),
SITZPLAETZE INT,
STEHPLAETZE INT)

CREATE TABLE ZUGVERBINDUNG (
Verbindungs_ID INT PRIMARY KEY,
Zug_ID INT,
FOREIGN KEY (ZUG_ID) REFERENCES ZUG (ZUG_ID),
STARTORT VARCHAR (100),
ANKUNFTSORT VARCHAR (100),
DATUM DATE,
DAUER TIME)

