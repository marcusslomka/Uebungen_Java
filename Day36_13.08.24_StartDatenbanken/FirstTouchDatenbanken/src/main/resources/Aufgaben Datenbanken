Drop Table if Exists DIRECTORS;
    Drop Table if Exists MOVIES;

    CREATE TABLE DIRECTORS(
        ID INT PRIMARY KEY,
        FIRSTNAME VARCHAR(20),
        LASTNAME VARCHAR(20),
        );

    INSERT INTO DIRECTORS VALUES (1,'Peter', 'Jackson');
