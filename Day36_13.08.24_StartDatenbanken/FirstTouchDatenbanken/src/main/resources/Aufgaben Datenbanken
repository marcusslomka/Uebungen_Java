    CREATE TABLE MOVIES(
        ID INT PRIMARY KEY,
        TITEL VARCHAR,
        GENRE VARCHAR,
        RELEASEYEAR INT,
        DIRECTOR_ID INT,
        FOREIGN KEY (DIRECTOR_ID) REFERENCES DIRECTORS(ID)
        );

