/* Filme gruppieren nach Genre: */
SELECT COUNT(*) AS `COUNT TITLE`,GENRE
FROM MOVIES
GROUP BY GENRE;

*/ Durchschnittliches Erscheinungsjahr pro Genre: */
SELECT avg(RELEASEYEAR),GENRE
FROM MOVIES
GROUP BY GENRE;

/*Top 5 Genres nach Anzahl der Filme: */
SELECT COUNT(*) AS `COUNT TITEL`,GENRE
FROM MOVIES
GROUP BY GENRE
ORDER BY COUNT(*) DESC LIMIT 5;

/* Jahr mit den meisten Filmen:*/
SELECT RELEASEYEAR, COUNT (ID) as `COUNT RELEASE_YEAR`
FROM MOVIES
GROUP BY RELEASEYEAR
ORDER BY `COUNT RELEASE_YEAR` DESC LIMIT 2;

/* Genres mit den meisten Filmen nach 2001 */
SELECT RELEASEYEAR, COUNT (ID) as `COUNT RELEASE_YEAR`
FROM MOVIES
WHERE RELEASEYEAR >2001
GROUP BY RELEASEYEAR
ORDER BY `COUNT RELEASE_YEAR` DESC LIMIT 1;

/* Genres nach der Anzahl der Filme sortiert: */
SELECT GENRE, COUNT(*)
FROM MOVIES
GROUP BY GENRE
ORDER BY COUNT(*);

/* Genre mit den ältesten durchschnittlichen Erscheinungsjahren: */
SELECT GENRE, avg(RELEASEYEAR) as `AVG RELEASEYEAR`
FROM MOVIES
GROUP BY GENRE
ORDER BY `AVG RELEASEYEAR` ASC;
